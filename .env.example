# Copy to .env (root) for local tooling, and to packages/web/.env for Vite
# (Vite only reads VITE_-prefixed vars from packages/web/.env).
# Never commit real values.

# --- Firebase (web app config, safe to expose client-side) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=umoja-games-dev
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to point the web app at the local Firebase emulator suite.
VITE_USE_FIREBASE_EMULATORS=true

# --- Cloud Functions secrets (set via `firebase functions:secrets:set NAME`, not .env) ---
# ANTHROPIC_API_KEY        - Claude API key, used for check-in selfie/ID verification and the AI chat widget
# STRIPE_SECRET_KEY        - Stripe test-mode secret key, for the $35 complaint fee Checkout session
# STRIPE_WEBHOOK_SECRET    - Stripe webhook signing secret
