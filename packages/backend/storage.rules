rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'commissioner']);
    }

    // Selfies & government ID photos: only the owner can upload; only the
    // owner or staff can ever read them back (never publicly listable).
    match /checkins/{uid}/{checkInId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Referee game-card photos: referee/staff only.
    match /gameCards/{gameId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Moments (photo/video) and Hunt submissions: public read, owner-scoped write.
    match /moments/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 100 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
    match /huntSubmissions/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 100 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // Public reference assets (logo, sponsor logos) — admin-managed, world-readable.
    match /public/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /sponsorLogos/{fileName} {
      allow read: if true;
      allow write: if isStaff() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Business-donor company logo uploaded during sponsorship checkout —
    // self-serve, owner-scoped write; public read since it may become a
    // public Sponsor logo once an admin converts the order.
    match /sponsorshipLogos/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
