rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      // This app's own `users` collection lives in the named `umoja13-app`
      // Firestore database, NOT the project's `(default)` database (that one
      // is Umoja Outreach's separate registration system — see
      // packages/backend/functions/src/util/admin.ts). Pointing this at
      // `(default)` meant `firestore.get()` always missed, so isStaff()
      // silently evaluated false for every admin/commissioner — breaking
      // every staff-gated storage rule below (sponsor logo uploads, staff
      // reads of check-in/volunteer photos, public-asset uploads) without
      // ever surfacing an error, since most of those paths are read via a
      // pre-resolved getDownloadURL() (which carries its own access token
      // and bypasses rules) rather than a live SDK read — a write like the
      // sponsor logo uploader has no such bypass, so it's the one that
      // visibly failed.
      return isSignedIn() && firestore.get(/databases/umoja13-app/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'commissioner']);
    }

    // Selfies & government ID photos: only the owner can upload; only the
    // owner or staff can ever read them back (never publicly listable).
    match /checkins/{uid}/{checkInId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Volunteer application photos: only the applicant can upload; only the
    // applicant or staff (reviewing the application) can read them back.
    match /volunteers/{uid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Referee game-card photos: referee/staff only.
    match /gameCards/{gameId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Moments (photo/video) and Hunt submissions: public read, owner-scoped write.
    match /moments/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 100 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
    match /huntSubmissions/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 100 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // Chat attachments (Pod/Team/Role/User channels): a message's mediaUrl is
    // uploaded here by the sender BEFORE the send*Message callable ever runs,
    // so this only gates the upload itself — the actual Firestore message
    // doc stays gated by each channel's own read rule (staff + membership).
    // Public read, like Moments/Hunt above: a getDownloadURL() link already
    // carries its own access token and bypasses these rules on fetch either
    // way, so a tighter read rule here wouldn't add real privacy.
    match /channelAttachments/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 50 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // Public reference assets (logo, sponsor logos) — admin-managed, world-readable.
    match /public/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /sponsorLogos/{fileName} {
      allow read: if true;
      allow write: if isStaff() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Business-donor company logo uploaded during sponsorship checkout —
    // guest checkout, so this is deliberately not scoped to auth.uid
    // (sponsoring shouldn't require an account); bounded by size/type
    // only. Public read since it may become a public Sponsor logo once an
    // admin converts the order.
    match /sponsorshipLogos/{ownerId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
