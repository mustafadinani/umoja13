{
  "name": "@umoja/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "vendor:shared": "npm run build --prefix ../../shared && rm -rf vendor/umoja-shared && mkdir -p vendor/umoja-shared && cp -R ../../shared/dist vendor/umoja-shared/dist && cp ../../shared/package.json vendor/umoja-shared/package.json",
    "build": "npm run vendor:shared && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed": "tsc -p tsconfig.json && node lib/seed/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@umoja/shared": "file:vendor/umoja-shared",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.1",
    "stripe": "^17.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.6.3"
  }
}
