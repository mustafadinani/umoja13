rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && role in me().roles;
    }

    function isStaff() {
      return hasRole('admin') || hasRole('commissioner');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid);
      // Self-serve join-a-team (no admin registration/invite system exists yet) may
      // promote a user to 'player'/'captain', but never to referee/commissioner/admin —
      // those privileged roles are only ever granted via the setUserRole Cloud Function
      // (Admin SDK, bypasses rules).
      allow update: if isOwner(uid) &&
        request.resource.data.roles.hasOnly(['fan', 'player', 'captain']) &&
        request.resource.data.primaryRole in ['fan', 'player', 'captain'];
      allow update: if isStaff();
    }

    // ---- reference data: public read, staff write ----
    match /categories/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /sponsors/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /huntMissions/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---- teams ----
    // Aggregate `stats` is written only by a Cloud Function trigger on game finalize.
    // Any signed-in user may touch only the `roster` field (self-serve join, and
    // captain jersey-number edits) — no admin-invite/import flow exists yet.
    match /teams/{teamId} {
      allow read: if true;
      allow update: if isStaff() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roster']));
      allow create, delete: if isStaff();
    }

    // ---- games ----
    // Referee assigned to a game may update gate-check/events/motm/gameCard/status;
    // commissioner/admin may update anything (score corrections, ref assignment, forfeits).
    match /games/{gameId} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isStaff() ||
        (isSignedIn() && resource.data.refereeUid == request.auth.uid);
      allow delete: if isStaff();
    }

    // ---- check-ins & tournament passes: sensitive PII (selfie, gov ID, DOB) ----
    // Only the player themselves, or admin/commissioner, may read/write these.
    // Captains/referees see only derived status via teams/{id}.roster, never the docs.
    match /checkIns/{checkInId} {
      // `resource == null` covers listening on a check-in that hasn't been created
      // yet (Firestore still evaluates read rules against a non-existent doc) —
      // must be allowed or the client gets a hard permission-denied error instead
      // of a normal "not found" snapshot.
      allow read: if isStaff() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status in ['not_started', 'rejected']);
      allow delete: if isStaff();
    }
    match /tournamentPasses/{passId} {
      allow read: if isStaff() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isStaff();
    }

    // ---- moments ----
    match /moments/{momentId} {
      allow read: if true;
      // Staff may also create a moment on a submitter's behalf — used when an
      // approved Hunt mission/challenge photo/video submission is mirrored
      // into the Moments wall so the whole community can see it.
      allow create: if isSignedIn() && (request.resource.data.postedBy == request.auth.uid || isStaff());
      allow update: if isStaff() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeUids']));
      allow delete: if isStaff() || (isSignedIn() && resource.data.postedBy == request.auth.uid);
    }

    // ---- incidents (unified complaint/flag/forfeit-notice/fan-message inbox) ----
    match /incidents/{incidentId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.filedByUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.filedByUid == request.auth.uid;
      allow update: if isStaff() || (isSignedIn() && resource.data.filedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread']));
    }

    // ---- Volunteers ----
    // Applications: applicant can read/create their own; approve/reject only via
    // the reviewVolunteerApplication Cloud Function (Admin SDK, bypasses rules —
    // it's the only path that grants the 'volunteer' role, same as setUserRole).
    match /volunteerApplications/{applicationId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.filedByUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.filedByUid == request.auth.uid &&
        request.resource.data.status == 'pending';
    }
    // Tasks/shifts: publicly readable (matches games/moments), staff manage the
    // task list, an assigned volunteer may only flag a conflict or mark done.
    match /volunteerTasks/{taskId} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (isSignedIn() && resource.data.assigneeUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantMake', 'cantMakeReason', 'done']));
    }

    // ---- The Hunt ----
    match /huntCrews/{crewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.leadUserId == request.auth.uid;
      allow update: if isStaff() || (isSignedIn() && !resource.data.locked &&
        request.auth.uid in resource.data.memberUids);
    }
    match /huntSubmissions/{submissionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isStaff();
    }

    // Challenges: admin-thrown, time-windowed questions with early-bird bonus
    // points. Approve/reject (and the bonus-rank computation) goes through the
    // reviewChallengeSubmission Cloud Function; isStaff() here just covers a
    // manual correction from the console.
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /challengeSubmissions/{submissionId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isStaff();
    }

    // ---- Sponsorship inquiries ("Become a Sponsor" CTA) ----
    match /sponsorInquiries/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.filedByUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.filedByUid == request.auth.uid &&
        request.resource.data.status == 'new';
      allow update: if isStaff();
    }

    // ---- Sponsorship orders (real $ tiers via Stripe Checkout) ----
    // Created only by the createSponsorshipCheckout Cloud Function (Admin SDK,
    // bypasses rules) and flipped to "paid" only by the Stripe webhook — no
    // client-side create rule needed. Staff convert a paid order into a public
    // Sponsor entry (or cancel it) from the admin dashboard.
    match /sponsorshipOrders/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.filedByUid == request.auth.uid);
      allow write: if isStaff();
    }

    // ---- Team channels: one-way staff broadcast + roster reply-back ----
    // Written only by the sendTeamMessage Cloud Function (Admin SDK, bypasses
    // rules), which derives `from` server-side from the caller's role/roster
    // membership rather than trusting a client-set field. Publicly readable,
    // same privacy posture as the team roster itself.
    match /teamChannels/{teamId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Role channels: one-way staff broadcast + member reply-back ----
    // Same pattern as teamChannels, scoped by role (volunteer/referee)
    // instead of team roster. Written only by sendRoleMessage. The referee
    // channel is restricted to staff + referees (referees asked to keep it
    // private); volunteer stays publicly readable.
    match /roleChannels/{role} {
      allow read: if role != 'referee' || isStaff() || hasRole('referee');
      allow write: if false;
    }

    // ---- notifications & chat escalations: written only by Cloud Functions ----
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /chatEscalations/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update: if isStaff();
    }

    // ---- server-only sequence counters (case numbers, pass ids) ----
    match /counters/{id} {
      allow read, write: if false;
    }

    // ---- UAT tracker (staging-only tool; shared checklist + append-only lists) ----
    match /uatScenarios/{scenarioId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /uatBugs/{bugId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.filedByUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.filedByUid == request.auth.uid;
    }
    match /uatSignoffs/{signoffId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
