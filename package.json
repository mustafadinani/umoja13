{
  "name": "umoja-games",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/shared",
    "packages/backend/functions",
    "packages/web",
    "packages/mobile"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace packages/shared",
    "dev:web": "npm run dev --workspace packages/web",
    "build:web": "npm run build --workspace packages/web",
    "build:shared": "npm run build --workspace packages/shared",
    "build:functions": "npm run build --workspace packages/backend/functions",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "emulators": "firebase emulators:start --project umoja-games-dev",
    "seed": "npm run seed --workspace packages/backend/functions"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
